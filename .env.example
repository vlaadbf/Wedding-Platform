# Copy to .dev.vars locally, or configure server-side secrets in hosting.
# Leave unconfigured integrations empty. Never put these values in public/client variables.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_FROM=
WHATSAPP_CONTENT_SID=
# Generate a long random value. Both the app and the scheduler need this value.
JOB_SECRET=
APP_ORIGIN=http://localhost:3000
# Online provider payments are not enabled by setting arbitrary Stripe keys.
# They require the additional Connect implementation described in LIMITATIONS.md.
